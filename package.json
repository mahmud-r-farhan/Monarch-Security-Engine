{
  "name": "monarch-security-engine",
  "version": "2.3.0",
  "description": "Professional Web Vulnerability Scanner, Attack Surface Mapper & Network Defense Platform — AI-Powered",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "monarch": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && node src/server.js",
    "demo:target": "node demo/target.js",
    "scan": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "echo 'No linter configured - using typecheck' && npm run typecheck",
    "python:service": "python3 services/python/advanced_scanner.py --server --port 5001",
    "go:service": "go run services/go/main.go -server -port 5002",
    "services": "concurrently \"npm run python:service\" \"npm run go:service\" \"npm run dev\"",
    "docker:build": "docker build -t monarch:local .",
    "docker:run": "docker run -p 3000:3000 monarch:local"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "security",
    "scanner",
    "vulnerability",
    "network-analyzer",
    "owasp",
    "ai",
    "devtools"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
