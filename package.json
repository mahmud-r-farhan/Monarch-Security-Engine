{
  "name": "monarch-security-engine",
  "version": "0.1.0",
  "description": "Automated Web Vulnerability Scanner & Network Analyzer (AI-Powered)",
  "type": "module",
  "main": "src/index.js",
  "bin": { "monarch": "src/cli.js" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo:target": "node demo/target.js",
    "scan": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "keywords": ["security", "scanner", "vulnerability", "network-analyzer", "owasp", "ai", "devtools"],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
