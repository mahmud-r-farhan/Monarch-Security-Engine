# ---- Monarch Security Engine configuration ----
PORT=3000

# AI provider: openrouter (recommended) | openai | anthropic | gemini | ollama | none  (auto-detected from keys if omitted)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Default: openai/gpt-4o-mini (fast, cheap, JSON-mode capable). Browse all: https://openrouter.ai/models
# Avoid reasoning models (deepseek-r1-*, o1, qwq) — their chain-of-thought often exceeds the timeout.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# How long to wait for an AI response before falling back to rules-based analysis (30s … 600s)
AI_TIMEOUT_MS=120000

# Ollama (local / self-hosted models — no API key required)
# Base URL of your Ollama server. Examples:
#   http://localhost:11434        (same machine)
#   http://192.168.1.20:11434     (LAN server)
#   https://ollama.mycompany.com  (behind reverse proxy)
OLLAMA_BASE_URL=http://localhost:11434
# Model must be pulled first:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Optional global model override (wins over provider-specific model vars)
AI_MODEL=

# Crawler: fetch (default, zero deps) | playwright (requires `npx playwright install chromium`)
CRAWLER=fetch
MAX_PAGES=25
REQUEST_TIMEOUT_MS=10000

# Safety: block scanning of private/loopback addresses (set to false only for local lab targets)
ALLOW_PRIVATE_TARGETS=true
