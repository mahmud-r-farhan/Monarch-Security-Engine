# ---- Monarch Security Engine configuration ----
PORT=3000

# AI provider: openrouter (recommended) | openai | anthropic | gemini | none  (auto-detected from keys if omitted)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-qwen-7b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional global model override
AI_MODEL=

# Crawler: fetch (default, zero deps) | playwright (requires `npx playwright install chromium`)
CRAWLER=fetch
MAX_PAGES=25
REQUEST_TIMEOUT_MS=10000

# Safety: block scanning of private/loopback addresses (set to false only for local lab targets)
ALLOW_PRIVATE_TARGETS=true
